<Project>
    <PropertyGroup>
        <!--
            Fallback for local builds only. Release and CI builds override this from the git tag
            (see .github/workflows/release.yaml), so the version is never maintained by hand.
        -->
        <PluginVersion Condition="'$(PluginVersion)' == ''">1.0.0.0</PluginVersion>
        <Version>$(PluginVersion)</Version>
        <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
        <FileVersion>$(PluginVersion)</FileVersion>
        <InformationalVersion>$(PluginVersion)</InformationalVersion>
    </PropertyGroup>
</Project>
